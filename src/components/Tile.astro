---
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';
import site from '../data/site.json';

interface Props {
  entry: CollectionEntry<'cases'>;
}
const { entry } = Astro.props;
const { title, tag, summary, cover, coverHeight, coverVideo, category, order } = entry.data;
// если обложки-картинки нет, а видео есть — до наведения показываем первый кадр видео
const frameAsCover = Boolean(coverVideo && !cover);
// «Настройки сайта → Чёрно-белые обложки на главной». Если поля нет в файле — ЧБ включено.
const grayscale = (site as { grayscaleCovers?: boolean }).grayscaleCovers !== false;
---

<a
  class:list={['tile', { 'tile--bw': grayscale }]}
  href={u(`/work/${entry.id}/`)}
  data-category={category}
  data-order={order}
>
  {
    // если не загружены ни обложка, ни видео — блока обложки нет совсем, плитка из одного текста
    (cover || coverVideo) && (
      <div class="tile__cover ph" style={`aspect-ratio: 468 / ${coverHeight}`}>
        {cover && <img src={u(cover)} alt={title} loading="lazy" decoding="async" />}
        {coverVideo && (
          // ролик играет, пока курсор на плитке. Если есть обложка-картинка — ролик грузится только
          // при первом наведении (preload="none"). Если обложки нет — сразу подгружается начало ролика,
          // и его первый кадр стоит вместо обложки (#t=0.001 нужен Safari, чтобы он показал кадр).
          <video
            class:list={['tile__video', { 'is-frame': frameAsCover }]}
            src={frameAsCover ? `${u(coverVideo)}#t=0.001` : u(coverVideo)}
            muted
            loop
            playsinline
            preload={frameAsCover ? 'metadata' : 'none'}
            aria-hidden="true"
          />
        )}
      </div>
    )
  }
  <div class="tile__info">
    <p class="tile__tag">{tag}</p>
    <p class="tile__title">{title}</p>
    <p class="tile__summary">{summary}</p>
  </div>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  .tile[hidden] {
    display: none;
  }
  .tile__cover {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .tile__cover img,
  .tile__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* видео показывается только когда реально пошло воспроизведение — без чёрного кадра при загрузке */
  .tile__video {
    visibility: hidden;
  }
  .tile__video.is-playing,
  .tile__video.is-frame {
    visibility: visible;
  }
  /* обложка (или первый кадр видео) чёрно-белая, при наведении на плитку — цветная.
     Включается в админке: «Настройки сайта → Чёрно-белые обложки на главной» (класс tile--bw).
     Только для устройств с мышью: на телефонах наведения нет, там обложки остаются цветными. */
  @media (hover: hover) {
    .tile--bw .tile__cover img,
    .tile--bw .tile__video {
      filter: grayscale(1);
      /* плавный переход в цвет и обратно; длительность — 0.4s */
      transition: filter 0.4s ease;
    }
    .tile--bw:hover .tile__cover img,
    .tile--bw:hover .tile__video,
    .tile--bw:focus-visible .tile__cover img,
    .tile--bw:focus-visible .tile__video {
      filter: none;
    }
  }
  .tile__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tile__tag {
    font-weight: 500;
    font-size: 12px;
    line-height: normal;
    color: var(--accent);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tile__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 30px;
    line-height: normal;
    letter-spacing: 0.6px;
    color: var(--text);
    text-transform: uppercase;
  }
  .tile__summary {
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  // Видео на плитке: играет, пока курсор над плиткой; при уходе — пауза и возврат к обложке.
  for (const tile of document.querySelectorAll<HTMLElement>('.tile')) {
    const video = tile.querySelector<HTMLVideoElement>('.tile__video');
    if (!video) continue;
    video.addEventListener('playing', () => {
      if (tile.matches(':hover')) video.classList.add('is-playing');
    });
    tile.addEventListener('mouseenter', () => {
      video.play().catch(() => {});
    });
    tile.addEventListener('mouseleave', () => {
      video.pause();
      video.classList.remove('is-playing');
      video.currentTime = 0;
    });
  }
</script>
