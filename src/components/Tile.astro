---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
}
const { entry } = Astro.props;
const { title, tag, summary, cover, coverHeight, coverVideo, category, order } = entry.data;
---

<a class="tile" href={`/work/${entry.id}/`} data-category={category} data-order={order}>
  <div class="tile__cover ph" style={`aspect-ratio: 468 / ${coverHeight}`}>
    {cover && <img src={cover} alt={title} loading="lazy" decoding="async" />}
    {
      coverVideo && (
        // ролик грузится только при первом наведении (preload="none") и играет, пока курсор на плитке
        <video class="tile__video" src={coverVideo} muted loop playsinline preload="none" aria-hidden="true" />
      )
    }
  </div>
  <div class="tile__info">
    <p class="tile__tag">{tag}</p>
    <p class="tile__title">{title}</p>
    <p class="tile__summary">{summary}</p>
  </div>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  .tile[hidden] {
    display: none;
  }
  .tile__cover {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .tile__cover img,
  .tile__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* видео показывается только когда реально пошло воспроизведение — без чёрного кадра при загрузке */
  .tile__video {
    visibility: hidden;
  }
  .tile__video.is-playing {
    visibility: visible;
  }
  .tile__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tile__tag {
    font-weight: 500;
    font-size: 12px;
    line-height: normal;
    color: var(--accent);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tile__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 30px;
    line-height: normal;
    letter-spacing: 0.6px;
    color: var(--text);
    text-transform: uppercase;
  }
  .tile__summary {
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  // Видео на плитке: играет, пока курсор над плиткой; при уходе — пауза и возврат к обложке.
  for (const tile of document.querySelectorAll<HTMLElement>('.tile')) {
    const video = tile.querySelector<HTMLVideoElement>('.tile__video');
    if (!video) continue;
    video.addEventListener('playing', () => {
      if (tile.matches(':hover')) video.classList.add('is-playing');
    });
    tile.addEventListener('mouseenter', () => {
      video.play().catch(() => {});
    });
    tile.addEventListener('mouseleave', () => {
      video.pause();
      video.classList.remove('is-playing');
      video.currentTime = 0;
    });
  }
</script>
