---
import { ratioOf } from '../lib/images';

interface Props {
  src?: string;
  alt?: string;
  /** видео вместо картинки: играет само, без звука, по кругу; картинка служит обложкой до загрузки */
  video?: string;
  /** пропорция для серой заглушки, если картинки ещё нет */
  fallbackRatio?: number;
  eager?: boolean;
}
const { src, alt = '', video, fallbackRatio = 16 / 9, eager = false } = Astro.props;
const ratio = ratioOf(src) ?? fallbackRatio;
---

<figure class="case-image ph" style={`aspect-ratio: ${ratio}`}>
  {src && <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />}
  {
    video && (
      <video
        src={video}
        poster={src}
        autoplay
        muted
        loop
        playsinline
        preload={eager ? 'auto' : 'metadata'}
        aria-label={alt || undefined}
      />
    )
  }
</figure>

<style>
  .case-image {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .case-image img,
  .case-image video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
