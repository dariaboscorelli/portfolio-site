---
import { ratioOf } from '../lib/images';

interface Props {
  src?: string;
  alt?: string;
  /** пропорция для серой заглушки, если картинки ещё нет */
  fallbackRatio?: number;
  eager?: boolean;
}
const { src, alt = '', fallbackRatio = 16 / 9, eager = false } = Astro.props;
const ratio = ratioOf(src) ?? fallbackRatio;
---

<figure class="case-image ph" style={`aspect-ratio: ${ratio}`}>
  {src && <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />}
</figure>

<style>
  .case-image {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .case-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
