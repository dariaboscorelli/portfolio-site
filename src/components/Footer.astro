---
import site from '../data/site.json';
---

<footer class="footer">
  <div class="footer__top">
    <p class="footer__title">Давайте работать<br />вместе</p>
    <div class="footer__contacts">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener">Telegram ↗</a>
      {
        site.behance ? (
          <a href={site.behance} target="_blank" rel="noopener">Behance ↗</a>
        ) : (
          <span>Behance ↗</span>
        )
      }
    </div>
  </div>
  <div class="footer__bottom">
    <p class="footer__copy">© {site.year} {site.name}</p>
    <a class="footer__up" href="#top">Наверх ↑</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 64px 40px 40px;
    background: var(--bg-footer);
    border-top: 1px solid var(--line);
    white-space: nowrap;
  }
  .footer__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    color: var(--text);
    text-transform: uppercase;
  }
  .footer__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 60px;
    line-height: 1.1;
  }
  .footer__contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    font-weight: 600;
    font-size: 18px;
    line-height: normal;
  }
  .footer__bottom {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }
  .footer__copy {
    font-family: var(--font-mono);
  }
  .footer__up {
    font-family: var(--font-sans);
  }
  /* почта, Telegram, Behance и «Наверх» при наведении — фирменный розовый, сразу, без перехода */
  .footer__contacts > *:hover,
  .footer__contacts > a:focus-visible,
  .footer__up:hover,
  .footer__up:focus-visible {
    color: var(--accent);
  }
</style>
