---
import site from '../data/site.json';
import { u } from '../lib/url';
---

<header class="header">
  <div class="header__left">
    <a class="header__name" href={u('/')}>{site.name}</a>
    <nav class="header__nav">
      <a href={u('/')}>Работы</a>
      <a href={u('/about/')}>Обо мне</a>
      <a href={u('/contacts/')}>Контакты</a>
    </nav>
  </div>
  <div class="header__right">
    <a class="header__tg" href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener">
      <img src={u('/icons/telegram.svg')} width="24" height="24" alt="" />
      <span>@{site.telegram}</span>
    </a>
    <a class="btn btn--outline" href={u(site.resume)} target="_blank" rel="noopener">Резюме PDF →</a>
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 40px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header__left {
    display: flex;
    align-items: center;
    gap: 70px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .header__name {
    font-weight: 600;
    font-size: 18px;
    line-height: normal;
    color: var(--accent);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
    font-weight: 500;
    font-size: 16px;
    line-height: normal;
    color: var(--text);
  }
  /* при наведении пункт меню становится фирменным розовым — сразу, без плавного перехода */
  .header__nav a:hover,
  .header__nav a:focus-visible {
    color: var(--accent);
  }
  .header__right {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .header__tg {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 16px;
    line-height: normal;
    color: var(--text);
    white-space: nowrap;
  }
</style>
