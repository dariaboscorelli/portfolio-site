---
import '@fontsource/inter/400.css';
import '@fontsource/inter/latin-700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <!-- Сайт свёрстан по десктопному макету 1440 px; телефоны показывают его целиком в уменьшенном виде -->
    <meta name="viewport" content="width=1440" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body id="top">
    <slot />
  </body>
</html>

<script>
  // «Шифровка» кнопок .btn: при наведении буквы на долю секунды перебираются случайными символами
  // и собираются обратно слева направо. Шрифт моноширинный, поэтому ширина кнопки не меняется.
  // Только для устройств с мышью; если в системе включено «уменьшить движение» — эффекта нет.
  const CHARS = 'АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЩЭЮЯ#%&*/<>01';
  const DURATION = 540; // мс — вся анимация
  const SPREAD = 420; // мс — за это время буквы по очереди встают на место

  if (matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const btn of document.querySelectorAll<HTMLElement>('.btn')) {
      const text = btn.textContent ?? '';
      // экранные дикторы читают исходный текст, а не перебор символов
      btn.setAttribute('aria-label', text);
      let raf = 0;
      btn.addEventListener('mouseenter', () => {
        cancelAnimationFrame(raf);
        const start = performance.now();
        const frame = (now: number) => {
          const t = now - start;
          let out = '';
          for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            const settled = ch === ' ' || t > 90 + i * (SPREAD / text.length);
            out += settled ? ch : CHARS[(Math.random() * CHARS.length) | 0];
          }
          btn.textContent = out;
          if (t < DURATION) raf = requestAnimationFrame(frame);
          else btn.textContent = text;
        };
        raf = requestAnimationFrame(frame);
      });
    }
  }
</script>
